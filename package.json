{
  "name": "bing-wallpaper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "serve ./packages/hono/dist",
    "build": "tsx packages/hono/build.ts",
    "wallpapers": "tsx scripts/wallpapers.ts",
    "markdown": "tsx scripts/markdown.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
